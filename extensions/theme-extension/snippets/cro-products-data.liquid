[
  {%- assign shaped_handles = items | map: 'handle' | uniq -%}
  {%- assign product_sep = '' -%}
  {%- for handle in shaped_handles -%}
    {%- assign source_product = all_products[handle] -%}
    {%- unless source_product.id -%}{%- continue -%}{%- endunless -%}

    {%- assign include_all_variants = false -%}
    {%- assign allowed_variant_key = '|' -%}
    {%- for item in items -%}
      {%- unless item.handle == handle -%}{%- continue -%}{%- endunless -%}
      {%- if item.variantIds == blank -%}
        {%- assign include_all_variants = true -%}
        {%- break -%}
      {%- endif -%}
      {%- assign joined_variant_ids = item.variantIds | join: '|' -%}
      {%- assign allowed_variant_key = allowed_variant_key | append: joined_variant_ids | append: '|' -%}
    {%- endfor -%}

    {%- assign emitted_variant_count = 0 -%}
    {%- assign lowest_variant_price = 0 -%}
    {%- assign any_variant_available = false -%}

    {%- capture variants_json -%}
      {%- assign variant_sep = '' -%}
      {%- for variant in source_product.variants -%}
        {%- unless include_all_variants -%}
          {%- assign variant_key = '|' | append: variant.id | append: '|' -%}
          {%- unless allowed_variant_key contains variant_key -%}{%- continue -%}{%- endunless -%}
        {%- endunless -%}

        {{ variant_sep }}{
          "id": {{ variant.id }},
          "title": {{ variant.title | json }},
          "values": {{ variant.options | json }},
          "price": {{ variant.price }},
          "compareAtPrice": {{ variant.compare_at_price | json }},
          "available": {{ variant.available | json }},
          "imageUrl": {%- if variant.image -%}{{ variant.image | image_url: width: 400 | json }}{%- else -%}null{%- endif -%}
        }
        {%- assign variant_sep = ',' -%}

        {%- if emitted_variant_count == 0 -%}
          {%- assign lowest_variant_price = variant.price -%}
        {%- elsif variant.price < lowest_variant_price -%}
          {%- assign lowest_variant_price = variant.price -%}
        {%- endif -%}
        {%- if variant.available -%}{%- assign any_variant_available = true -%}{%- endif -%}

        {%- assign emitted_variant_count = emitted_variant_count | plus: 1 -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if emitted_variant_count == 0 -%}{%- continue -%}{%- endif -%}

    {{ product_sep }}{
      "id": {{ source_product.id }},
      "handle": {{ source_product.handle | json }},
      "title": {{ source_product.title | json }},
      "imageUrl": {%- if source_product.featured_image -%}{{ source_product.featured_image | image_url: width: 400 | json }}{%- else -%}null{%- endif -%},
      "price": {{ lowest_variant_price }},
      "available": {{ any_variant_available | json }},
      "optionNames": [
        {%- assign option_sep = '' -%}
        {%- for option in source_product.options_with_values -%}
          {{ option_sep }}{{ option.name | json }}
          {%- assign option_sep = ',' -%}
        {%- endfor -%}
      ],
      "variants": [{{ variants_json }}]
    }
    {%- assign product_sep = ',' -%}
  {%- endfor -%}
]
