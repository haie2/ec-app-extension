{%- liquid
  assign tmpl = request.page_type
  assign key = 'global_css'
  if theme and theme.id != blank
    assign key = 'global_css_' | append: theme.id
  endif
  assign ecom_configs = shop.metafields.ecomposer.configs.value
-%}

<!-- DNS Prefetch & Preconnect -->
<link rel="preconnect" href="https://cdn.ecomposer.app" crossorigin>
<link rel="dns-prefetch" href="https://cdn.ecomposer.app">
{% comment %} <link rel="preload" href="https://cdn.ecomposer.app/vendors/css/ecom-base.css?v=1.8" as="style"> {% endcomment %}
<link rel="prefetch" href="https://cdn.ecomposer.app/vendors/css/ecom-swiper@11.css" as="style">
<link rel="prefetch" href="https://cdn.ecomposer.app/vendors/js/ecom-swiper@11.0.5.js" as="script">
<link rel="prefetch" href="https://cdn.ecomposer.app/vendors/js/ecom_modal.js" as="script">

<!-- Global CSS -->
{%- if app.metafields.ecomposer[key] and false -%}
  <!--ECOM-EMBED-->
  <style id="ecom-global-css" class="ecom-global-css-theme" data-key="{{key}}" data-theme-id="{{theme.id}}">
    {{- app.metafields.ecomposer[key] -}}
  </style>
  <!--/ECOM-EMBED-->
{%- elsif app.metafields.ecomposer.global_css -%}
  <!--ECOM-EMBED-->
  <style id="ecom-global-css" class="ecom-global-css">
    {{- app.metafields.ecomposer.global_css -}}
  </style>
  <!--/ECOM-EMBED-->
{%- elsif shop.metafields.ecomposer.global_css -%}
  <!--ECOM-EMBED-->
  <link href="data:text/css;base64,{{- shop.metafields.ecomposer.global_css -}}" rel="stylesheet" id="ecom-global-css">
  <!--/ECOM-EMBED-->
{%- endif -%}

<!-- Custom CSS & JS -->
{%- if ecom_configs -%}
  {%- if ecom_configs.custom_code.custom_css -%}
    <style id="ecom-custom-css">{{- ecom_configs.custom_code.custom_css -}}</style>
  {%- endif -%}
  {%- if ecom_configs.custom_code.custom_js -%}
    <script id="ecom-custom-js" async>{{- ecom_configs.custom_code.custom_js -}}</script>
  {%- endif -%}
{%- endif -%}

<!-- Open Graph Meta Tags for Pages -->
{%- if tmpl == 'page' and page.metafields.ecomposer.featured_image -%}
  <meta property="og:image" content="{{page.metafields.ecomposer.featured_image.value}}">
  <meta property="og:image:alt" content="{{page_title}}">
  <meta property="og:image:secure_url" content="{{page.metafields.ecomposer.featured_image.value}}">
  <meta property="og:image:width" content="1080">
  <meta property="og:image:height" content="720">
{%- endif -%}

<!-- AI Search Optimization (LLM Outreach) -->
{%- assign ai_seo_settings = shop.metafields.ecomposer.ai_seo_settings.value -%}
{%- if ai_seo_settings -%}
  {%- if request.page_type == 'product' or request.page_type == 'index' -%}
    {%- if ai_seo_settings.store_sell != blank or ai_seo_settings.store_different != blank -%}
      <script type="application/ld+json" id="ecom-ai-seo-brand-profile">
        {
          "@context": "https://schema.org",
          "@type": "Organization",
          "name": {{ shop.name | json }},
          "url": {{ shop.secure_url | json }},
          "description": {{ ai_seo_settings.store_sell | json }},
          "brand": {
            "@type": "Brand",
            "name": {{ shop.name | json }},
            "description": {{ ai_seo_settings.store_different | json }}
          }
        }
      </script>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
<!-- Critical Inline Styles -->
