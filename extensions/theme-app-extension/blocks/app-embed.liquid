<script src="{{ 'ecom-abtesting.js' | asset_url }}" defer></script>
{%- endif -%}
{%- schema -%}
{
  "name": "EComposer Theme Helper",
  "target": "head",
  "javascript": "ecom.js",
  "settings": []
}
{%- endschema -%}