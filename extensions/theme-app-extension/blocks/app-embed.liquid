{%- if shop.metafields.ecomposer['ajax-cart'] -%}
this.configs.ajax_cart={{shop.metafields.ecomposer['ajax-cart'].value|json}};
{%- else -%}
this.configs.ajax_cart={enable:false};
{%- endif -%}
{%- if shop.customer_accounts_enabled and customer -%}
